---
interface Props {
  nombre: string;
  congregacion: string;
  foto: string;
}

const {
  nombre,
  congregacion,
  foto
} = Astro.props;
---

<div>

  <div class="hero-image">
    <img src={foto} alt={nombre} />
  </div>

  <div class="content">
    <h1>{nombre}</h1>

    <p class="location">
      📍 {congregacion}
    </p>
  </div>

</div>